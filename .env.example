# Copiez ce fichier en .env puis remplissez les valeurs réelles.

# Depuis console.groq.com (gratuit)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Depuis console.twilio.com (compte d'essai gratuit)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Mot de passe de votre choix pour consulter /bookings?key=...
# (si vide, la route /bookings est désactivée)
ADMIN_KEY=choisissez-une-longue-phrase-secrete

# Adresse publique après le déploiement sur Render (vide en local)
PUBLIC_BASE_URL=

# Chemin de la base de données (inutile à modifier)
DATABASE_PATH=./data/agent.db

# Uniquement pour Render : contenu complet du fichier token.json sur UNE ligne
# (en local, laissez vide : le fichier token.json est utilisé)
GOOGLE_TOKEN_JSON=
